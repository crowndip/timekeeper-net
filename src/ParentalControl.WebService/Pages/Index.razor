@page "/"
@using ParentalControl.WebService.Services
@using ParentalControl.WebService.Data
@using Microsoft.EntityFrameworkCore
@inject IDatabaseInitializationService DbInit
@inject AppDbContext DbContext
@inject NavigationManager Navigation
@inject LocalizationService Localizer
@inject LanguageService LangService

<PageTitle>@T("Dashboard.PageTitle")</PageTitle>

@if (isChecking)
{
    <div class="loading-container">
        <div class="spinner"></div>
        <p>@T("Common.Loading")</p>
    </div>
}
else if (needsSetup)
{
    <div class="container">
        <div class="alert alert-warning">
            <h4>@T("Setup.Title")</h4>
            <p>@T("Setup.Description")</p>
            <a href="/setup" class="btn btn-primary">@T("Setup.InitializeButton")</a>
        </div>
    </div>
}
else
{
    <div class="dashboard">
        <!-- Header -->
        <div class="dashboard-header">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
                <div>
                    <h1>🛡️ @T("Dashboard.PageTitle")</h1>
                    <p class="subtitle">@T("Dashboard.Subtitle")</p>
                </div>
                <div style="display: flex; align-items: center; gap: 16px;">
                    <LanguageSelector />
                    <div style="text-align: right; font-size: 12px; color: #6b7280;">
                        <div style="font-weight: 600;">Version @appVersion</div>
                        <div style="margin-top: 4px;">Build @buildDate</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- System Status Card -->
        <div class="status-card">
            <div class="status-header">
                <span class="status-icon">✅</span>
                <span class="status-title">@T("Dashboard.SystemStatus")</span>
            </div>
            <div class="status-grid">
                <div class="status-item">
                    <span class="status-label">@T("Dashboard.Database")</span>
                    <span class="status-value status-online">@T("Dashboard.Online")</span>
                </div>
                <div class="status-item">
                    <span class="status-label">@T("Dashboard.SchemaVersion")</span>
                    <span class="status-value">@dbVersion</span>
                </div>
                <div class="status-item">
                    <span class="status-label">@T("Dashboard.ActiveUsers")</span>
                    <span class="status-value">@userCount</span>
                </div>
                <div class="status-item">
                    <span class="status-label">@T("Dashboard.RegisteredDevices")</span>
                    <span class="status-value">@computerCount</span>
                </div>
            </div>
        </div>

        <!-- Recent Activity -->
        @if (recentActivity.Any())
        {
            <div class="status-card" style="margin-bottom: 30px;">
                <div class="status-header">
                    <span class="status-icon">🕐</span>
                    <span class="status-title">Recent Activity</span>
                </div>
                <div style="display: grid; gap: 12px;">
                    @foreach (var activity in recentActivity.Take(5))
                    {
                        <div style="display: flex; justify-content: space-between; align-items: center; padding: 12px; background: #f9fafb; border-radius: 8px;">
                            <div>
                                <strong>@activity.PrimaryUsername</strong>
                                @if (activity.IsAlias)
                                {
                                    <span style="color: #6b7280; font-size: 14px;"> (as @activity.ActualUsername)</span>
                                }
                                <div style="font-size: 12px; color: #6b7280; margin-top: 4px;">
                                    @activity.ComputerName
                                </div>
                            </div>
                            <div style="text-align: right;">
                                <div style="font-size: 14px; font-weight: 600; color: @(activity.MinutesRemaining <= 0 ? "#ef4444" : activity.MinutesRemaining < 30 ? "#f59e0b" : "#10b981");">
                                    @(activity.MinutesRemaining == int.MaxValue ? "Unlimited" : $"{activity.MinutesRemaining} min left")
                                </div>
                                <div style="font-size: 12px; color: #6b7280;">
                                    @activity.LastSeen.ToString("HH:mm")
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Quick Actions -->
        <div class="cards-grid">
            <div class="card card-users">
                <div class="card-icon">👥</div>
                <h3>@T("Dashboard.Users")</h3>
                <p>@T("Dashboard.UsersDesc")</p>
                <a href="/users" class="card-btn">@T("Dashboard.ManageUsers")</a>
            </div>

            <div class="card card-profiles">
                <div class="card-icon">⏱️</div>
                <h3>@T("Dashboard.TimeProfiles")</h3>
                <p>@T("Dashboard.TimeProfilesDesc")</p>
                <a href="/profiles" class="card-btn">@T("Dashboard.ManageProfiles")</a>
            </div>

            <div class="card card-allowed-hours">
                <div class="card-icon">🕐</div>
                <h3>@T("Dashboard.AllowedHours")</h3>
                <p>@T("Dashboard.AllowedHoursDesc")</p>
                <a href="/allowed-hours" class="card-btn">@T("Dashboard.ConfigureHours")</a>
            </div>

            <div class="card card-computers">
                <div class="card-icon">💻</div>
                <h3>@T("Dashboard.Devices")</h3>
                <p>@T("Dashboard.DevicesDesc")</p>
                <a href="/computers" class="card-btn">@T("Dashboard.ViewDevices")</a>
            </div>

            <div class="card card-reports">
                <div class="card-icon">📊</div>
                <h3>@T("Dashboard.Reports")</h3>
                <p>@T("Dashboard.ReportsDesc")</p>
                <a href="/reports" class="card-btn">@T("Dashboard.ViewReports")</a>
            </div>

            <div class="card card-detailed-reports">
                <div class="card-icon">📊</div>
                <h3>@T("Dashboard.DetailedReports")</h3>
                <p>@T("Dashboard.DetailedReportsDesc")</p>
                <a href="/detailed-reports" class="card-btn">@T("Dashboard.ViewDetailedReports")</a>
            </div>

            <div class="card card-configuration">
                <div class="card-icon">⚙️</div>
                <h3>@T("Dashboard.Configuration")</h3>
                <p>@T("Dashboard.ConfigurationDesc")</p>
                <a href="/configuration" class="card-btn">@T("Dashboard.ViewConfiguration")</a>
            </div>

            <div class="card card-about">
                <div class="card-icon">ℹ️</div>
                <h3>@T("Dashboard.About")</h3>
                <p>@T("Dashboard.AboutDesc")</p>
                <a href="/about" class="card-btn">@T("Dashboard.ViewAbout")</a>
            </div>
        </div>

        <!-- Footer Info -->
        <div class="footer-info">
            <p>Server Version: 1.1.2 | Database Schema: @dbVersion</p>
        </div>
    </div>
}

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        padding: 20px;
    }

    .loading-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 80vh;
        color: white;
    }

    .spinner {
        width: 50px;
        height: 50px;
        border: 4px solid rgba(255, 255, 255, 0.3);
        border-top-color: white;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .alert {
        background: white;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    .alert-warning {
        border-left: 4px solid #f59e0b;
    }

    .dashboard {
        max-width: 1200px;
        margin: 0 auto;
    }

    .dashboard-header {
        text-align: center;
        color: white;
        margin-bottom: 30px;
    }

    .dashboard-header h1 {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .subtitle {
        font-size: 1.1rem;
        opacity: 0.9;
    }

    .status-card {
        background: white;
        border-radius: 16px;
        padding: 24px;
        margin-bottom: 30px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    }

    .status-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
        padding-bottom: 16px;
        border-bottom: 2px solid #f3f4f6;
    }

    .status-icon {
        font-size: 1.5rem;
    }

    .status-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: #1f2937;
    }

    .status-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
    }

    .status-item {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .status-label {
        font-size: 0.875rem;
        color: #6b7280;
        font-weight: 500;
    }

    .status-value {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1f2937;
    }

    .status-online {
        color: #10b981;
    }

    .cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .card {
        background: white;
        border-radius: 16px;
        padding: 28px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
    }

    .card-icon {
        font-size: 3rem;
        margin-bottom: 16px;
    }

    .card h3 {
        font-size: 1.5rem;
        font-weight: 600;
        color: #1f2937;
        margin-bottom: 12px;
    }

    .card p {
        color: #6b7280;
        margin-bottom: 20px;
        line-height: 1.5;
    }

    .card-btn {
        display: inline-block;
        padding: 12px 24px;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
        width: 100%;
        max-width: 200px;
    }

    .card-users .card-btn {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

    .card-profiles .card-btn {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        color: white;
    }

    .card-computers .card-btn {
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        color: white;
    }

    .card-reports .card-btn {
        background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
        color: white;
    }

    .card-configuration .card-btn {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

    .card-about .card-btn {
        background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
        color: white;
    }

    .card-btn:hover {
        transform: scale(1.05);
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
    }

    .footer-info {
        text-align: center;
        color: white;
        opacity: 0.8;
        font-size: 0.875rem;
        padding: 20px 0;
    }

    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 12px 24px;
        border-radius: 8px;
        text-decoration: none;
        display: inline-block;
        font-weight: 600;
        border: none;
        cursor: pointer;
        transition: transform 0.3s ease;
    }

    .btn-primary:hover {
        transform: scale(1.05);
    }

    /* Mobile Responsive */
    @@media (max-width: 768px) {
        body {
            padding: 10px;
        }

        .dashboard-header h1 {
            font-size: 1.75rem;
        }

        .subtitle {
            font-size: 0.95rem;
        }

        .status-card {
            padding: 16px;
        }

        .status-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
        }

        .status-value {
            font-size: 1.25rem;
        }

        .cards-grid {
            grid-template-columns: 1fr;
            gap: 16px;
        }

        .card {
            padding: 20px;
        }

        .card-icon {
            font-size: 2.5rem;
        }

        .card h3 {
            font-size: 1.25rem;
        }
    }

    @@media (max-width: 480px) {
        .status-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    private string currentLang = "en";
    private bool isChecking = true;
    private bool needsSetup = false;
    private string dbVersion = "Unknown";
    private int userCount = 0;
    private int computerCount = 0;
    private List<RecentActivityItem> recentActivity = new();
    
    private string appVersion = "Unknown";
    private string buildDate = "Unknown";

    protected override async Task OnInitializedAsync()
    {
        currentLang = LangService.GetCurrentLanguage();
        
        var assembly = System.Reflection.Assembly.GetExecutingAssembly();
        var version = assembly.GetName().Version;
        appVersion = version != null ? $"v{version.Major}.{version.Minor}.{version.Build}" : "Unknown";
        
        var buildDateAttr = assembly.GetCustomAttributes(typeof(System.Reflection.AssemblyInformationalVersionAttribute), false)
            .FirstOrDefault() as System.Reflection.AssemblyInformationalVersionAttribute;
        buildDate = buildDateAttr?.InformationalVersion ?? DateTime.UtcNow.ToString("yyyy-MM-dd");
        
        try
        {
            var isInitialized = await DbInit.IsDatabaseInitializedAsync();
            needsSetup = !isInitialized;
            
            if (needsSetup)
            {
                Navigation.NavigateTo("/setup", true);
            }
            else
            {
                await LoadDatabaseInfo();
                await LoadCounts();
                await LoadRecentActivity();
            }
        }
        catch (Exception)
        {
            needsSetup = true;
            Navigation.NavigateTo("/setup", true);
        }
        finally
        {
            isChecking = false;
        }
    }

    private async Task LoadDatabaseInfo()
    {
        try
        {
            var latestMigration = await DbContext.Database
                .SqlQueryRaw<string>("SELECT \"MigrationId\" FROM \"__EFMigrationsHistory\" ORDER BY \"MigrationId\" DESC LIMIT 1")
                .ToListAsync();
            
            if (latestMigration.Any())
            {
                var migrationId = latestMigration.First();
                dbVersion = migrationId.Length >= 8 ? migrationId.Substring(0, 8) : migrationId;
            }
        }
        catch
        {
            dbVersion = "Unknown";
        }
    }

    private async Task LoadCounts()
    {
        try
        {
            userCount = await DbContext.Users.CountAsync();
            computerCount = await DbContext.Computers.CountAsync();
        }
        catch (Npgsql.PostgresException ex) when (ex.SqlState == "42P01")
        {
            needsSetup = true;
            Navigation.NavigateTo("/setup", true);
        }
    }

    private async Task LoadRecentActivity()
    {
        try
        {
            var today = DateOnly.FromDateTime(DateTime.UtcNow);
            var sessions = await DbContext.Sessions
                .Include(s => s.User)
                    .ThenInclude(u => u.PrimaryUser)
                .Include(s => s.Computer)
                .Where(s => s.SessionStart >= DateTime.UtcNow.AddHours(-24))
                .OrderByDescending(s => s.UpdatedAt)
                .Take(10)
                .ToListAsync();

            var timeCalc = new ParentalControl.WebService.Services.TimeCalculationService(
                DbContext,
                new ParentalControl.WebService.Services.UserResolutionService(DbContext)
            );

            var activities = new List<RecentActivityItem>();
            foreach (var session in sessions)
            {
                var primaryUser = session.User.PrimaryUserId.HasValue ? session.User.PrimaryUser : session.User;
                if (primaryUser == null) continue;

                var timeRemaining = await timeCalc.CalculateTimeRemainingAsync(primaryUser.Id, today);
                
                activities.Add(new RecentActivityItem
                {
                    PrimaryUsername = primaryUser.Username,
                    ActualUsername = session.User.Username,
                    IsAlias = session.User.PrimaryUserId.HasValue,
                    ComputerName = session.Computer?.Hostname ?? "Unknown",
                    LastSeen = session.UpdatedAt,
                    MinutesRemaining = timeRemaining
                });
            }

            recentActivity = activities
                .GroupBy(a => a.PrimaryUsername)
                .Select(g => g.OrderByDescending(a => a.LastSeen).First())
                .OrderByDescending(a => a.LastSeen)
                .ToList();
        }
        catch
        {
            recentActivity = new();
        }
    }

    private class RecentActivityItem
    {
        public string PrimaryUsername { get; set; } = string.Empty;
        public string ActualUsername { get; set; } = string.Empty;
        public bool IsAlias { get; set; }
        public string ComputerName { get; set; } = string.Empty;
        public DateTime LastSeen { get; set; }
        public int MinutesRemaining { get; set; }
    }

    private string T(string key) => Localizer.Get(currentLang, key);
}
